{
    "name": "bit-es/core",
    "description": "This is bites package with core models that maybe used by any other models as its attributes",
    "keywords": [
        "bit-es",
        "core",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/bit-es/core",
    "support": {
        "issues": "https://github.com/bit-es/core/issues",
        "source": "https://github.com/bit-es/core"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "bit-es",
            "email": "bit.ecosystem@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "bit-es/core": "dev-main",
        "filament/filament": "^4.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Bites\\Core\\": "src/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan migrate"
        ],
        "post-update-cmd": [],
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bites\\Core\\CoreServiceProvider"
            ],
            "aliases": {
                "Core": "Bites\\Core\\Facades\\Core"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}